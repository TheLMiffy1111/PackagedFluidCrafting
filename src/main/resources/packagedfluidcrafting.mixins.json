	"refmap": "packagedfluidcrafting.refmap.json",
	"target": "@env(DEFAULT)",
	"compatibilityLevel": "JAVA_8",
	"plugin": "thelm.packagedfluidcrafting.mixin.PackagedFluidCraftingMixinPlugin",
	"mixins": [
		"PackagedFluidCraftingCanceller",
		"ItemRecipeHolderMixin",
		"ItemPackageMixin",
		"TileUnpackagerMixin",
		"TileDistributorMixin",
		"TilePackagingProviderMixin",
		"PackageCraftingPatternHelperMixin",
		"RecipeCraftingPatternHelperMixin",
